{
  "name": "zafira-hub-api",
  "version": "2.0.0",
  "description": "Zafira Hub 2.0 Backend API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsup src --out-dir dist --format esm --clean",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
