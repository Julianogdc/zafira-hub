{
    "name": "@zafira/api",
    "version": "2.0.0",
    "description": "Zafira Hub 2.0 Backend API",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "prisma generate && tsup src --out-dir dist --format esm --clean",
        "start": "node dist/server.js",
        "db:migrate": "prisma migrate deploy",
        "db:status": "prisma migrate status",
        "db:seed": "prisma db seed",
        "admin:set-password": "tsx scripts/set-admin-password.ts",
        "test": "tsx --test src/lib/__tests__/*.test.ts",
        "prisma:generate": "prisma generate"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/cors": "^10.0.2",
        "@fastify/jwt": "^10.2.2",
        "@fastify/multipart": "^10.1.1",
        "@fastify/rate-limit": "^11.2.0",
        "@prisma/client": "^6.4.1",
        "@zafira/contracts": "^0.1.0",
        "argon2": "^0.45.1",
        "dotenv": "^16.4.7",
        "fastify": "^5.2.1",
        "zod": "^4.6.2"
    },
    "devDependencies": {
        "@types/node": "^22.13.9",
        "prisma": "^6.4.1",
        "tsup": "^8.4.0",
        "tsx": "^4.19.3",
        "typescript": "^5.8.2"
    },
    "private": true
}
