# ==============================================================================
# ZAFIRA HUB 2.1 — INVENTÁRIO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# CLASSIFICAÇÃO DE VARIÁVEIS:
#  - [OBRIGATÓRIA GLOBAL]: Exigida para funcionamento e inicialização da API em produção.
#  - [CONDICIONAL]: Exigida somente quando a respectiva funcionalidade/agendador estiver ativado.
#  - [OPCIONAL / DEFAULT]: Possui fallback seguro pré-configurado no código.
#
# REGRA DE GOVERNANÇA:
#  - NUNCA inserir valores reais, senhas de produção ou credenciais neste arquivo.
#  - Valores abaixo são puramente demonstrativos (placeholders seguros).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRAESTRUTURA BÁSICA E SERVIDOR
# ------------------------------------------------------------------------------
# [OBRIGATÓRIA GLOBAL] Ambiente de execução: "development" | "test" | "production"
NODE_ENV=development

# [OPCIONAL / DEFAULT: 3001] Porta do servidor Fastify
PORT=3001

# [OBRIGATÓRIA GLOBAL] URL de conexão com o PostgreSQL (exige banco dedicado isolado)
# Em produção, senhas fracas ou de desenvolvimento são terminantemente rejeitadas.
DATABASE_URL="postgresql://usuario_exemplo:senha_forte_minimo_32_chars_random@127.0.0.1:5432/zafira_hub_db?schema=public"

# [OPCIONAL / DEFAULT: "http://localhost:5173"] Origens permitidas para CORS (separadas por vírgula)
# Em homologação/produção same-origin: "https://testehub.zafiramkt.com.br"
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# [OPCIONAL / DEFAULT: false] Configuração de proxy reverso seguro (Traefik / Nginx)
# Aceita: false | "127.0.0.1" | "10.0.0.0/8" | lista de IPs confiáveis. "true" irrestrito é proibido.
TRUST_PROXY="127.0.0.1"

# [OPCIONAL / DEFAULT: "info"] Nível de log: "fatal" | "error" | "warn" | "info" | "debug" | "trace"
LOG_LEVEL="info"

# ------------------------------------------------------------------------------
# 2. SEGREDOS CRIPTOGRÁFICOS E SESSÃO (OBRIGATÓRIAS EM PRODUÇÃO)
# ------------------------------------------------------------------------------
# [OBRIGATÓRIA GLOBAL] Segredo para assinatura de tokens JWT (mínimo 32 caracteres de alta entropia)
JWT_SECRET="insira_aqui_uma_chave_jwt_secreta_com_minimo_32_caracteres_aleatorios"

# [OBRIGATÓRIA GLOBAL] Segredo para assinatura e cifragem de cookies de sessão HTTP-only (mínimo 32 caracteres)
COOKIE_SECRET="insira_aqui_uma_chave_cookie_secreta_com_minimo_32_caracteres_distintos"

# [OPCIONAL / DEFAULT: "lax"] Atributo SameSite dos cookies: "lax" | "strict" | "none"
COOKIE_SAMESITE="lax"

# [OBRIGATÓRIA GLOBAL] Chave mestra para criptografia AES-256-GCM de credenciais de integração no banco
# Deve ser uma string de alta entropia com no mínimo 32 caracteres ou 64 caracteres hexadecimais.
INTEGRATION_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef_exemplo"

# [OBRIGATÓRIA GLOBAL] Segredo para geração e validação de tokens HMAC de aprovação pública de mídias (F8)
# Não pode ser idêntico a JWT_SECRET nem a COOKIE_SECRET (segregação de chaves).
APPROVAL_MEDIA_SECRET="insira_aqui_chave_hmac_exclusiva_de_aprovacao_minimo_32_caracteres"

# [CONDICIONAL / RECOMENDADO] Chave para hash de identidade (HMAC) de participantes da Agenda Google
# Obrigatória se GOOGLE_CALENDAR_SYNC_SCHEDULE_ENABLED=true.
CALENDAR_IDENTITY_HMAC_KEY="insira_aqui_chave_hmac_agenda_google_minimo_32_caracteres"

# [OPCIONAL] Chave de API para autenticação máquina-a-máquina (scripts e rotas internas protegidas)
# Se informada em produção, deve conter no mínimo 32 caracteres de alta entropia.
HUB_INTERNAL_API_KEY=""

# [OPCIONAL] Organizações permitidas para o token de máquina HUB_INTERNAL_API_KEY (separadas por vírgula)
HUB_INTERNAL_API_KEY_ORGS=""

# ------------------------------------------------------------------------------
# 3. ARMAZENAMENTO DE ARQUIVOS PRIVADO (S3 / CLOUDFLARE R2 - F8 / HM-2 / HM-3)
# ------------------------------------------------------------------------------
# [OBRIGATÓRIA GLOBAL EM PRODUÇÃO] Driver de armazenamento: "s3"
# Driver "local" é EXCLUSIVO para desenvolvimento/testes e terminantemente recusado em produção.
FILE_STORAGE_DRIVER="s3"

# [OBRIGATÓRIA COM DRIVER S3] Nome do bucket privado (sem URLs públicas)
FILE_STORAGE_S3_BUCKET="zafira-hub-arquivos-homologacao"

# [OBRIGATÓRIA COM DRIVER S3] Chave de acesso / Access Key ID
FILE_STORAGE_S3_ACCESS_KEY_ID="identificador_de_acesso_s3_ou_r2"

# [OBRIGATÓRIA COM DRIVER S3] Chave secreta / Secret Access Key
FILE_STORAGE_S3_SECRET_ACCESS_KEY="chave_secreta_s3_ou_r2_minimo_16_caracteres"

# [OBRIGATÓRIA COM R2 / COMPATÍVEIS] Endpoint do serviço S3 compatível (deve utilizar estritamente HTTPS)
# Exemplo Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
FILE_STORAGE_S3_ENDPOINT="https://exemplo-conta-r2.r2.cloudflarestorage.com"

# [OPCIONAL / DEFAULT: "auto"] Região do bucket S3 ("auto" para Cloudflare R2)
FILE_STORAGE_S3_REGION="auto"

# [OPCIONAL] Prefixo/subpasta base no bucket (ex: "homologacao/")
FILE_STORAGE_S3_PREFIX=""

# [OPCIONAL / DEFAULT: true quando há endpoint] Forçar estilo de caminho (Path-style URL)
FILE_STORAGE_S3_FORCE_PATH_STYLE="true"

# [PROIBIDO EM PRODUÇÃO] Permitir HTTP sem criptografia no S3 (somente para emuladores locais de teste)
FILE_STORAGE_S3_ALLOW_INSECURE="false"

# [OPCIONAL] Diretório local para driver "local" fora de produção
FILE_STORAGE_LOCAL_DIR=""

# ------------------------------------------------------------------------------
# 4. OBSERVABILIDADE E MÉTRICAS PROMETHEUS
# ------------------------------------------------------------------------------
# [CONDICIONAL] Token Bearer para proteção do endpoint /metrics (machine-only)
METRICS_BEARER_TOKEN=""

# ------------------------------------------------------------------------------
# 5. AGENDADORES E DESPACHANTES INTERNOS (OFF-BY-DEFAULT)
# ------------------------------------------------------------------------------
# Na homologação sintética (HM-4), todos devem permanecer "false" (desligados).

# [CONDICIONAL / DEFAULT: false] Agendador do espelho do Asana (F6-IMP.8)
ASANA_MIRROR_SCHEDULE_ENABLED="false"
ASANA_MIRROR_NIGHTLY_HOUR="3"
ASANA_MIRROR_WEBHOOK_DEBOUNCE_SECONDS="10"

# [CONDICIONAL / DEFAULT: false] Agendador de sincronização do Google Calendar (F7-3a)
GOOGLE_CALENDAR_SYNC_SCHEDULE_ENABLED="false"
GOOGLE_CALENDAR_SYNC_INTERVAL_MINUTES="15"

# [CONDICIONAL / DEFAULT: false] Despachante de automações n8n (F7-4a)
N8N_DISPATCH_ENABLED="false"
N8N_DISPATCH_INTERVAL_SECONDS="30"

# [CONDICIONAL / DEFAULT: false] Despachante de publicação de conteúdos (F8-4a)
PUBLICATION_DISPATCH_ENABLED="false"
PUBLICATION_DISPATCH_INTERVAL_SECONDS="30"

# [CONDICIONAL / DEFAULT: false] Coletor de métricas de publicação (F8-5a)
PUBLICATION_METRICS_ENABLED="false"

# ------------------------------------------------------------------------------
# 6. INTEGRAÇÕES EXTERNAS (DESLIGADAS NA HOMOLOGAÇÃO SINTÉTICA)
# ------------------------------------------------------------------------------
# Asana
ASANA_CLIENT_ID=""
ASANA_CLIENT_SECRET=""
ASANA_REDIRECT_URI=""
ASANA_DEV_PAT="" # Somente fora de produção
ASANA_API_BASE_URL="https://app.asana.com/api/1.0"

# Google Calendar / OAuth
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""
GOOGLE_OAUTH_AUTH_URL="https://accounts.google.com/o/oauth2/v2/auth"
GOOGLE_OAUTH_TOKEN_URL="https://oauth2.googleapis.com/token"
GOOGLE_CALENDAR_API_BASE="https://www.googleapis.com/calendar/v3"

# Automações n8n
N8N_CALLBACK_BASE_URL=""
N8N_ALLOWED_HOSTS=""
N8N_ALLOW_INSECURE_HTTP="false"

# BrightBean / Social Publisher
BRIGHTBEAN_API_URL=""
BRIGHTBEAN_API_KEY=""
BRIGHTBEAN_WORKSPACE_ID=""

# Postiz
POSTIZ_URL=""
POSTIZ_API_KEY=""

# Asaas
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://api.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN=""

# Banco Inter PJ (mTLS)
INTER_CLIENT_ID=""
INTER_CLIENT_SECRET=""
INTER_CERTIFICATE_CRT_BASE64=""
INTER_PRIVATE_KEY_BASE64=""
INTER_CERTIFICATE_PASSPHRASE=""
INTER_OAUTH_SCOPE="extrato.read"
INTER_BASE_URL="https://cdpj.partners.bancointer.com.br"
