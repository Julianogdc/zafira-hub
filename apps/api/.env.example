# ==============================================================================
# ZAFIRA HUB 2.1 — INVENTÁRIO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# CLASSIFICAÇÃO DE VARIÁVEIS:
#  - [OBRIGATÓRIA GLOBAL]: Exigida para funcionamento da API em produção/homologação.
#  - [CONDICIONAL]: Exigida quando a respectiva funcionalidade estiver ativada.
#  - [OPCIONAL / DEFAULT]: Possui fallback seguro pré-configurado no código.
#
# REGRA DE GOVERNANÇA:
#  - NUNCA inserir valores reais, senhas de produção ou credenciais neste arquivo.
#  - Valores abaixo são puramente demonstrativos (placeholders seguros).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRAESTRUTURA BÁSICA E SERVIDOR
# ------------------------------------------------------------------------------
# [OBRIGATÓRIA GLOBAL] Ambiente de execução: "development" | "test" | "production"
NODE_ENV=development

# [OPCIONAL / DEFAULT: 3001] Porta do servidor Fastify
PORT=3001

# [OBRIGATÓRIA GLOBAL] URL de conexão com o PostgreSQL (exige banco dedicado isolado)
# Em produção, senhas fracas ou de desenvolvimento são rejeitadas.
DATABASE_URL="postgresql://zafira_hub_app:sua_senha_aqui@localhost:5432/zafira_hub_v2?schema=public"

# [OPCIONAL / DEFAULT: "http://localhost:5173"] Origens permitidas para CORS
CORS_ORIGIN="http://localhost:5173"

# [OPCIONAL / DEFAULT: false] Proxy reverso seguro (Traefik / Nginx). "true" irrestrito é proibido.
TRUST_PROXY="127.0.0.1"

# [OPCIONAL / DEFAULT: "info"] Nível de log
LOG_LEVEL="info"

# ------------------------------------------------------------------------------
# 2. SEGREDOS CRIPTOGRÁFICOS E SESSÃO (OBRIGATÓRIAS EM PRODUÇÃO)
# ------------------------------------------------------------------------------
# [OBRIGATÓRIA GLOBAL] Segredo para tokens JWT (mínimo 32 caracteres)
JWT_SECRET="CHANGE_ME"

# [OBRIGATÓRIA GLOBAL] Segredo para cookies HTTP-only (mínimo 32 caracteres)
COOKIE_SECRET="CHANGE_ME"

# [OPCIONAL / DEFAULT: "lax"] Atributo SameSite dos cookies: "lax" | "strict" | "none"
COOKIE_SAMESITE="lax"

# [OBRIGATÓRIA EM HOMOLOGAÇÃO] Chave para cifragem AES-256 de credenciais de integração
INTEGRATION_ENCRYPTION_KEY="CHANGE_ME"

# [OBRIGATÓRIA EM HOMOLOGAÇÃO] Chave HMAC para aprovação pública de mídias (F8)
APPROVAL_MEDIA_SECRET="CHANGE_ME"

# [CONDICIONAL] Chave HMAC de identidade para participantes da Agenda Google
CALENDAR_IDENTITY_HMAC_KEY="CHANGE_ME"

# [OPCIONAL] Chave de API para autenticação de máquina (scripts internos)
HUB_INTERNAL_API_KEY="CHANGE_ME"

# [OPCIONAL] Organizações permitidas para o token de máquina
HUB_INTERNAL_API_KEY_ORGS=""

# ------------------------------------------------------------------------------
# 3. ARMAZENAMENTO DE ARQUIVOS PRIVADO (S3 / CLOUDFLARE R2 - F8 / HM-2 / HM-3)
# ------------------------------------------------------------------------------
# [OBRIGATÓRIA GLOBAL EM PRODUÇÃO] Driver de armazenamento: "s3"
# Driver "local" é terminantemente recusado em produção.
# FILE_STORAGE_DRIVER="s3"
# FILE_STORAGE_S3_BUCKET="zafira-hub-arquivos-staging"
# FILE_STORAGE_S3_ACCESS_KEY_ID="identificador_acesso_s3"
# FILE_STORAGE_S3_SECRET_ACCESS_KEY="CHANGE_ME"
# FILE_STORAGE_S3_ENDPOINT="https://exemplo-r2.cloudflarestorage.com"
# FILE_STORAGE_S3_REGION="auto"
# FILE_STORAGE_S3_PREFIX=""
# FILE_STORAGE_S3_FORCE_PATH_STYLE="true"
# FILE_STORAGE_S3_ALLOW_INSECURE="false"
FILE_STORAGE_LOCAL_DIR=""

# ------------------------------------------------------------------------------
# 4. OBSERVABILIDADE E MÉTRICAS PROMETHEUS
# ------------------------------------------------------------------------------
METRICS_BEARER_TOKEN="CHANGE_ME"

# ------------------------------------------------------------------------------
# 5. AGENDADORES E DESPACHANTES INTERNOS (OFF-BY-DEFAULT)
# ------------------------------------------------------------------------------
# Na homologação sintética (HM-4), todos permanecem "false" (desligados).
ASANA_MIRROR_SCHEDULE_ENABLED="false"
ASANA_MIRROR_NIGHTLY_HOUR="3"
ASANA_MIRROR_WEBHOOK_DEBOUNCE_SECONDS="10"

GOOGLE_CALENDAR_SYNC_SCHEDULE_ENABLED="false"
GOOGLE_CALENDAR_SYNC_INTERVAL_MINUTES="15"

N8N_DISPATCH_ENABLED="false"
N8N_DISPATCH_INTERVAL_SECONDS="30"

PUBLICATION_DISPATCH_ENABLED="false"
PUBLICATION_DISPATCH_INTERVAL_SECONDS="30"
PUBLICATION_METRICS_ENABLED="false"

# ------------------------------------------------------------------------------
# 6. INTEGRAÇÕES EXTERNAS (DESLIGADAS NA HOMOLOGAÇÃO SINTÉTICA)
# ------------------------------------------------------------------------------
ASANA_CLIENT_ID=""
ASANA_CLIENT_SECRET="CHANGE_ME"
ASANA_REDIRECT_URI=""
ASANA_DEV_PAT="CHANGE_ME"
ASANA_API_BASE_URL="https://app.asana.com/api/1.0"

GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET="CHANGE_ME"
GOOGLE_OAUTH_REDIRECT_URI=""
GOOGLE_OAUTH_AUTH_URL="https://accounts.google.com/o/oauth2/v2/auth"
GOOGLE_OAUTH_TOKEN_URL="https://oauth2.googleapis.com/token"
GOOGLE_CALENDAR_API_BASE="https://www.googleapis.com/calendar/v3"

N8N_CALLBACK_BASE_URL=""
N8N_ALLOWED_HOSTS=""
N8N_ALLOW_INSECURE_HTTP="false"

BRIGHTBEAN_API_URL=""
BRIGHTBEAN_API_KEY="CHANGE_ME"
BRIGHTBEAN_WORKSPACE_ID=""

POSTIZ_URL=""
POSTIZ_API_KEY="CHANGE_ME"

ASAAS_API_KEY="CHANGE_ME"
ASAAS_BASE_URL="https://api.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN="CHANGE_ME"

INTER_CLIENT_ID=""
INTER_CLIENT_SECRET="CHANGE_ME"
INTER_CERTIFICATE_CRT_BASE64="CHANGE_ME"
INTER_PRIVATE_KEY_BASE64="CHANGE_ME"
INTER_CERTIFICATE_PASSPHRASE="CHANGE_ME"
INTER_OAUTH_SCOPE="extrato.read"
INTER_BASE_URL="https://cdpj.partners.bancointer.com.br"
