generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAUSED
  INACTIVE
}

enum IntegrationProvider {
  TWENTY
  ASANA
  POSTIZ
  META
  GOOGLE_ADS
  ASAAS
}

enum AsaasPaymentStatus {
  PENDING
  RECEIVED
  CONFIRMED
  OVERDUE
  REFUNDED
  DELETED
  CANCELLED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            OrganizationMember[]
  clients            Client[]
  integrations       OrganizationIntegration[]
  oauthStates        OAuthState[]
  asanaSubscriptions     AsanaWebhookSubscription[]
  asaasPayments          AsaasPayment[]
  financialAccounts      FinancialAccount[]
  financialCategories    FinancialCategory[]
  financialCategoryRules FinancialCategoryRule[]
  financialTransactions  FinancialTransaction[]
  financialTransfers     FinancialTransfer[]

  @@map("organizations")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships        OrganizationMember[]
  responsibleClients Client[]
  oauthStates        OAuthState[]

  @@map("users")
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Client {
  id                String       @id @default(uuid())
  organizationId    String
  name              String
  legalName         String?
  document          String?
  email             String?
  phone             String?
  status            ClientStatus @default(LEAD)
  responsibleUserId String?
  contractValue     Decimal?     @db.Decimal(12, 2)
  startDate         DateTime?
  endDate           DateTime?
  notes             String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsibleUser User?               @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)
  integrations    ClientIntegration[]
  asaasPayments   AsaasPayment[]
  financialTransactions  FinancialTransaction[] @relation("ClientTransactions")
  suggestedTransactions  FinancialTransaction[] @relation("SuggestedClientTransactions")
  financialCategoryRules FinancialCategoryRule[]

  @@index([organizationId])
  @@index([status])
  @@index([responsibleUserId])
  @@map("clients")
}

model ClientIntegration {
  id         String              @id @default(uuid())
  clientId   String
  provider   IntegrationProvider
  externalId String
  metadata   Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, provider, externalId])
  @@index([provider, externalId])
  @@map("client_integrations")
}

model OrganizationIntegration {
  id             String              @id @default(uuid())
  organizationId String
  provider       IntegrationProvider
  accessToken    String?             @db.Text
  refreshToken   String?             @db.Text
  expiresAt      DateTime?
  workspaceId    String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([provider])
  @@map("organization_integrations")
}

model OAuthState {
  id             String              @id @default(uuid())
  nonce          String              @unique
  organizationId String
  userId         String
  provider       IntegrationProvider @default(ASANA)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime            @default(now())

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, nonce])
  @@index([expiresAt])
  @@map("oauth_states")
}

model AsanaWebhookSubscription {
  id             String    @id @default(uuid())
  organizationId String
  resourceGid    String
  webhookGid     String?
  target         String
  secret         String    @db.Text
  active         Boolean   @default(false)
  lastEventAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, resourceGid])
  @@index([resourceGid])
  @@index([webhookGid])
  @@map("asana_webhook_subscriptions")
}

model AsaasPayment {
  id                 String             @id @default(uuid())
  organizationId     String
  clientId           String?
  asaasCustomerId    String
  externalId         String             @unique
  installmentNumber  Int?
  description        String?
  value              Decimal            @db.Decimal(12, 2)
  netValue           Decimal?           @db.Decimal(12, 2)
  originalValue      Decimal?           @db.Decimal(12, 2)
  interestValue      Decimal?           @db.Decimal(12, 2)
  billingType        String             @default("UNDEFINED")
  status             AsaasPaymentStatus @default(PENDING)
  dueDate            DateTime
  paymentDate        DateTime?
  clientPaymentDate  DateTime?
  invoiceUrl         String?
  bankSlipUrl        String?
  rawPayload         Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId])
  @@index([asaasCustomerId])
  @@index([status])
  @@index([dueDate])
  @@map("asaas_payments")
}

model AsaasWebhookEvent {
  id                 String   @id @default(uuid())
  dedupeKey          String   @unique
  eventId            String?
  event              String
  paymentExternalId  String?
  processedAt        DateTime @default(now())
  payload            Json?

  @@index([paymentExternalId])
  @@index([dedupeKey])
  @@map("asaas_webhook_events")
}

enum FinancialAccountProvider {
  ASAAS
  INTER
}

enum FinancialTransactionDirection {
  CREDIT
  DEBIT
}

enum FinancialTransactionKind {
  CUSTOMER_PAYMENT
  TRANSFER_INTERNAL
  FEE
  EXPENSE
  TAX
  ADJUSTMENT
  OTHER
}

enum FinancialCategorizationSource {
  PROVIDER
  AUTO_RULE
  MANUAL
  PENDING
}

enum FinancialDatePrecision {
  DATE_ONLY
  DATETIME
}

enum FinancialTransferStatus {
  UNMATCHED
  REVIEW
  AUTO_MATCHED
  CONFIRMED
}

enum FinancialCategoryType {
  INCOME
  EXPENSE
  TRANSFER
  FEE
  TAX
  OTHER
}

enum FinancialMatchField {
  DESCRIPTION
  COUNTERPARTY_NAME
  COUNTERPARTY_DOCUMENT
}

enum FinancialMatchType {
  CONTAINS
  EXACT
}

model FinancialAccount {
  id             String                   @id @default(uuid())
  organizationId String
  provider       FinancialAccountProvider
  name           String
  currency       String                   @default("BRL")
  currentBalance Decimal                  @default(0) @db.Decimal(14, 2)
  balanceAsOf    DateTime?
  lastSyncedAt   DateTime?
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions    FinancialTransaction[]
  sourceTransfers FinancialTransfer[]     @relation("SourceAccountTransfers")
  destTransfers   FinancialTransfer[]     @relation("DestAccountTransfers")

  @@unique([organizationId, provider, name])
  @@index([organizationId])
  @@index([provider])
  @@map("financial_accounts")
}

model FinancialCategory {
  id             String                @id @default(uuid())
  organizationId String
  name           String
  type           FinancialCategoryType
  color          String?
  isSystem       Boolean               @default(false)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules        FinancialCategoryRule[]
  transactions FinancialTransaction[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([type])
  @@map("financial_categories")
}

model FinancialCategoryRule {
  id                   String              @id @default(uuid())
  organizationId       String
  categoryId           String
  clientId             String?
  matchField           FinancialMatchField
  matchType            FinancialMatchType
  matchValueNormalized String
  priority             Int                 @default(0)
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     FinancialCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  client       Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([categoryId])
  @@index([clientId])
  @@index([priority])
  @@map("financial_category_rules")
}

model FinancialTransaction {
  id                       String                        @id @default(uuid())
  organizationId           String
  accountId                String
  externalId               String
  occurredAt               DateTime
  datePrecision            FinancialDatePrecision        @default(DATE_ONLY)
  direction                FinancialTransactionDirection
  kind                     FinancialTransactionKind
  amount                   Decimal                       @db.Decimal(14, 2)
  description              String
  counterpartyName         String?
  counterpartyDocument     String?
  externalReference        String?
  categoryId               String?
  clientId                 String?
  suggestedClientId        String?
  categorizationSource     FinancialCategorizationSource @default(PENDING)
  categorizationConfidence Decimal?                      @db.Decimal(5, 2)
  rawPayload               Json?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account         FinancialAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category        FinancialCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  client          Client?             @relation("ClientTransactions", fields: [clientId], references: [id], onDelete: SetNull)
  suggestedClient Client?             @relation("SuggestedClientTransactions", fields: [suggestedClientId], references: [id], onDelete: SetNull)
  sourceTransfer  FinancialTransfer?  @relation("SourceTransactionTransfer")
  destTransfer    FinancialTransfer?  @relation("DestTransactionTransfer")

  @@unique([accountId, externalId])
  @@index([organizationId])
  @@index([accountId])
  @@index([occurredAt])
  @@index([direction])
  @@index([kind])
  @@index([categoryId])
  @@index([clientId])
  @@index([suggestedClientId])
  @@index([categorizationSource])
  @@map("financial_transactions")
}

model FinancialTransfer {
  id                       String                  @id @default(uuid())
  organizationId           String
  sourceAccountId          String
  destinationAccountId     String
  sourceTransactionId      String                  @unique
  destinationTransactionId String?                 @unique
  amount                   Decimal                 @db.Decimal(14, 2)
  transferredAt            DateTime
  status                   FinancialTransferStatus @default(UNMATCHED)
  confidence               Decimal                 @default(0) @db.Decimal(5, 2)
  matchReason              String?
  confirmedAt              DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceAccount          FinancialAccount      @relation("SourceAccountTransfers", fields: [sourceAccountId], references: [id], onDelete: Cascade)
  destinationAccount     FinancialAccount      @relation("DestAccountTransfers", fields: [destinationAccountId], references: [id], onDelete: Cascade)
  sourceTransaction      FinancialTransaction  @relation("SourceTransactionTransfer", fields: [sourceTransactionId], references: [id], onDelete: Cascade)
  destinationTransaction FinancialTransaction? @relation("DestTransactionTransfer", fields: [destinationTransactionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([status])
  @@index([transferredAt])
  @@map("financial_transfers")
}

