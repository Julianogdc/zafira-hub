# ==============================================================================
# ZAFIRA HUB 2.1 — EXEMPLO DE CONFIGURAÇÃO DE AMBIENTE DE HOMOLOGAÇÃO
# ==============================================================================
# AVISO DE SEGURANÇA:
# Este arquivo é um modelo de referência estrutural.
# Todas as variáveis obrigatórias de credenciais e imagens são intencionalmente
# deixadas VAZIAS neste modelo. Se copiado diretamente sem preenchimento, o
# Docker Compose falhará explicitamente (fail-closed), prevenindo a subida
# acidental com senhas ou valores demonstrativos.
# NUNCA insira senhas reais ou credenciais de produção neste repositório.
# Em homologação física, gere valores aleatórios de alta entropia para cada variável.
# Endereço planejado: https://<subdominio-de-homologacao-dedicado> (não configurado nesta sessão).
# ==============================================================================

# Runtime do Node e Porta da API
NODE_ENV=production
PORT=3001

# Imagens Imutáveis Obrigatórias (DEVEM conter '@sha256:<64 hex>')
# NUNCA utilizar tags mutáveis como ':latest' ou ':stable'.
# A conformidade do digest deve ser verificada com scripts/homologation/validate-immutable-images.sh antes do deploy.
API_IMAGE_REF=
WEB_IMAGE_REF=

# Parâmetros do Banco de Dados PostgreSQL Dedicado
# OBRIGATÓRIO: Apontar exclusivamente para a base dedicada de homologação.
# COMPATIBILIDADE OBRIGATÓRIA: Os valores de POSTGRES_USER, POSTGRES_PASSWORD e POSTGRES_DB
# DEVEM ser estritamente compatíveis com a string DATABASE_URL informada abaixo.
POSTGRES_USER=zafira_hml_user
POSTGRES_PASSWORD=
POSTGRES_DB=zafira_hub_21_staging

# String de Conexão com o Banco de Dados Dedicado
# Formato de referência: postgresql://user:pass@postgres:5432/zafira_hub_21_staging?schema=public (substituindo user e pass pelas credenciais configuradas)
# PROIBIDO: NUNCA apontar para 'zafira_hub_v2' (banco de produção)
DATABASE_URL=

# Segredos Criptográficos Obrigatórios (HM-4a)
# O startup-validator da API valida a entropia e exige que cada segredo seja
# gerado de forma independente e com valor único (segregação estrita; proibido reutilizar).
# JWT_SECRET: Mínimo 32 caracteres com alta entropia
JWT_SECRET=

# COOKIE_SECRET: Mínimo 32 caracteres com alta entropia (distinto do JWT_SECRET)
COOKIE_SECRET=

# INTEGRATION_ENCRYPTION_KEY: Chave de 32 bytes em formato hexadecimal (exatamente 64 hexadecimais) para cifragem AES-256-GCM
INTEGRATION_ENCRYPTION_KEY=

# APPROVAL_MEDIA_SECRET: Chave dedicada para assinatura de tokens de links públicos de aprovação (mínimo 32 caracteres)
APPROVAL_MEDIA_SECRET=

# Segredos Opcionais / Condicionais
# Deixar vazios se não estiverem em uso, para não acionar validação desnecessária no startup-validator.
# HUB_INTERNAL_API_KEY: Chave de autenticação para métricas e chamadas de máquina (mínimo 32 caracteres quando fornecida)
HUB_INTERNAL_API_KEY=

# CALENDAR_IDENTITY_HMAC_KEY: Obrigatório se GOOGLE_CALENDAR_SYNC_SCHEDULE_ENABLED=true (mínimo 32 caracteres)
CALENDAR_IDENTITY_HMAC_KEY=

# Driver de Armazenamento de Arquivos Privado (HM-2 / HM-3 / HM-4a)
# 'local' é terminantemente proibido em ambiente de produção/homologação.
# FILE_STORAGE_S3_ENDPOINT deve utilizar estritamente o protocolo HTTPS.
FILE_STORAGE_DRIVER=s3
FILE_STORAGE_S3_BUCKET=zafira-hub-staging-storage
FILE_STORAGE_S3_REGION=auto
FILE_STORAGE_S3_ENDPOINT=https://substitua_pelo_account_id.r2.cloudflarestorage.com
FILE_STORAGE_S3_ACCESS_KEY_ID=
FILE_STORAGE_S3_SECRET_ACCESS_KEY=

# Integrações Externas e Despachantes (Desligados por Padrão)
# Em homologação inicial, todos devem permanecer estritamente como 'false'.
# A HM-4b comprovou a ausência de chamadas externas especificamente para o caminho do BrightBean desconectado.
PUBLICATION_DISPATCH_ENABLED=false
PUBLICATION_METRICS_ENABLED=false
GOOGLE_CALENDAR_SYNC_SCHEDULE_ENABLED=false
ASANA_MIRROR_SCHEDULE_ENABLED=false
N8N_DISPATCH_ENABLED=false
N8N_AUTOMATION_DISPATCH_ENABLED=false

# Configuração de Upstream e Rede do Web Nginx (Same-Origin Reverse Proxy)
API_UPSTREAM=http://api:3001
WEB_PORT=8082
