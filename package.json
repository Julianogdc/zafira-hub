{
  "name": "zafira-hub",
  "version": "2.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@zafira/web",
    "dev:api": "npm run dev --workspace=@zafira/api",
    "build:web": "npm run build --workspace=@zafira/web",
    "build:api": "npm run build --workspace=@zafira/api",
    "build": "npm run build:web && npm run build:api",
    "test": "npm run test --workspace=@zafira/api",
    "lint": "npm run lint --workspace=@zafira/web",
    "typecheck:contracts": "npm run typecheck --workspace=@zafira/contracts",
    "prisma:generate": "npm run prisma:generate --workspace=@zafira/api"
  },
  "packageManager": "npm@11.6.2"
}
